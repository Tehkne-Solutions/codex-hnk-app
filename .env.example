# Expo public variables
EXPO_PUBLIC_SUPABASE_URL=https://czgqjrxkveatlnyjiwds.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-sb_publishable-key

# Auth origins / callbacks
# Production web origin reserved by the first official Vercel RC deployment.
HNK_WEB_ORIGIN=https://codex-hnk-app-thales-dvfs-projects.vercel.app

# Optional Auth callback override for a specific build target.
# Leave unset for platform-aware defaults:
# - native standalone/development build: hnk://auth/callback via Expo Linking
# - web: current origin
# Production Supabase Auth URL Configuration must allow BOTH exact origins below:
# - hnk://auth/callback
# - https://codex-hnk-app-thales-dvfs-projects.vercel.app
# EXPO_PUBLIC_AUTH_REDIRECT_URL=hnk://auth/callback
